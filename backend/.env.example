# ---------- 应用 ----------
APP_NAME=学业过程管理与智能决策系统
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ---------- 数据库（MySQL 8.0） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的MySQL密码
DB_NAME=student_academic
DB_CHARSET=utf8mb4
# 连接池：池化 + 溢出 + 回收，避免长连接被 MySQL 8h 断掉
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 业务默认值 ----------
# 默认每学期选课学分上限
DEFAULT_MAX_CREDITS_PER_SEMESTER=30
# 及格线
PASS_SCORE=60
# 选课分布式锁等待/超时（秒）
SELECT_LOCK_TIMEOUT=5
